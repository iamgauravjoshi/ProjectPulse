# Local development only. Copy to .env; never use these credentials publicly.
POSTGRES_USER=projectpulse
POSTGRES_PASSWORD=projectpulse_local
POSTGRES_DB=projectpulse
POSTGRES_PORT=54329
# Set to an existing database volume name when upgrading an earlier local install.
POSTGRES_DATA_VOLUME=projectpulse_pgdata
DATABASE_URL=postgresql+psycopg://projectpulse:projectpulse_local@127.0.0.1:54329/projectpulse
# Destructive integration tests require a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql+psycopg://projectpulse:projectpulse_local@127.0.0.1:54329/projectpulse_test
# Next.js server-side transport destination; set in the frontend process if changed.
API_BASE_URL=http://127.0.0.1:8000
