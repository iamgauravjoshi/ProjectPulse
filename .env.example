# Local development only. Copy to .env; never use these credentials publicly.
POSTGRES_USER=projectpulse
POSTGRES_PASSWORD=projectpulse_local
POSTGRES_DB=projectpulse
POSTGRES_PORT=54329
# Set to an existing database volume name when upgrading an earlier local install.
POSTGRES_DATA_VOLUME=projectpulse_pgdata
POSTGRES_DATA_VOLUME_EXTERNAL=false
# Defaults match a new PostgreSQL 18 installation. For an existing PostgreSQL 17
# volume, set BOTH values as documented in docs/development/local-setup.md.
# POSTGRES_IMAGE=pgvector/pgvector:0.8.1-pg17@sha256:3e8b3adfd27b5707128f60956f62a793c3c9326ea8cfaf0eab7adccb5d700b21
# POSTGRES_DATA_TARGET=/var/lib/postgresql/data
DATABASE_URL=postgresql+psycopg://projectpulse:projectpulse_local@127.0.0.1:54329/projectpulse
# Destructive integration tests require a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql+psycopg://projectpulse:projectpulse_local@127.0.0.1:54329/projectpulse_test
# Next.js server-side transport destination; set in the frontend process if changed.
API_BASE_URL=http://127.0.0.1:8000
# Optional, server-only Gemini embeddings. Never use NEXT_PUBLIC_ or commit a real key.
# Allow generativelanguage.googleapis.com in the runtime's outbound HTTP policy.
GEMINI_API_KEY=
# Optional server-side generation model for relevance (separate from embeddings).
GEMINI_RELEVANCE_MODEL=gemini-2.5-flash
GEMINI_EVENT_MODEL=gemini-3.5-flash-lite
