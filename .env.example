# Local development only. Copy to .env; never use these credentials publicly.
POSTGRES_USER=contextboard
POSTGRES_PASSWORD=contextboard_local
POSTGRES_DB=contextboard
POSTGRES_PORT=54329
DATABASE_URL=postgresql+psycopg://contextboard:contextboard_local@127.0.0.1:54329/contextboard
# Destructive integration tests require a separate database whose name ends in _test.
TEST_DATABASE_URL=postgresql+psycopg://contextboard:contextboard_local@127.0.0.1:54329/contextboard_test
# Next.js server-side transport destination; set in the frontend process if changed.
API_BASE_URL=http://127.0.0.1:8000
